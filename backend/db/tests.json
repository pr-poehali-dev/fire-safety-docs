{
  "tests": [
    {
      "name": "Reject request without auth token",
      "method": "GET",
      "path": "/?table=object_characteristics",
      "expectedStatus": 401
    },
    {
      "name": "Reject POST without auth token",
      "method": "POST",
      "path": "/",
      "body": {
        "table": "object_characteristics",
        "name": "X"
      },
      "expectedStatus": 401
    },
    {
      "name": "Reject invalid token",
      "method": "GET",
      "path": "/?table=object_characteristics",
      "headers": {
        "X-Auth-Token": "invalid.token.here"
      },
      "expectedStatus": 401
    },
    {
      "name": "Handle CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
}
